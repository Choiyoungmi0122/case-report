{
  "name": "care-backend",
  "version": "1.0.0",
  "description": "EMR-based Case Report (CARE) Writing Support Tool - Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "study:snapshot": "tsx --env-file=.env scripts/buildStudyCaseSnapshot.ts",
    "study:freeze": "tsx scripts/freezeStudyCase.ts",
    "test:rag": "tsx tests/rag/termNormalizer.test.ts",
    "test:rag-loader": "tsx tests/rag/terminologyLoader.test.ts",
    "test:rag-hybrid": "tsx tests/rag/hybridRetriever.test.ts",
    "test:rag-semantic": "tsx tests/rag/semanticMatcher.test.ts",
    "test:rag-resolver": "tsx tests/rag/resolver.test.ts",
    "test:rag-runtime": "tsx tests/rag/runtimeIntegration.test.ts",
    "test:deid": "tsx tests/deid/deid.test.ts",
    "test:privacy": "tsx tests/deid/privacyIntegration.test.ts",
    "test:frontmatter": "tsx tests/frontmatter/frontMatterPreview.test.ts",
    "test:workflow": "tsx tests/workflow/pendingTermWorkflow.test.ts && tsx tests/workflow/pendingTermLatency.test.ts",
    "test:export": "tsx tests/export/docxExport.test.ts",
    "test:timeline-import": "tsx tests/timeline/timelineImport.test.ts",
    "test:optimization": "tsx tests/optimization/chainRuntime.test.ts",
    "test:common-questions": "tsx tests/questions/commonQuestions.test.ts",
    "test:study": "tsx tests/study/studyMode.test.ts",
    "test:study-integration": "tsx tests/study/studyPersistence.integration.test.ts",
    "test:research-export": "tsx tests/research/researchExport.test.ts",
    "test:research-session": "tsx tests/research/researchSession.test.ts",
    "test:privacy-outbound": "tsx tests/privacy/outboundBoundary.test.ts",
    "test:privacy-payload": "tsx tests/privacy/outboundPayload.test.ts",
    "test:privacy-gate": "tsx tests/privacy/highRiskGate.test.ts",
    "test:privacy-clinical": "tsx tests/privacy/clinicalTermFalsePositive.test.ts",
    "test:privacy-render": "tsx tests/privacy/publicationRenderer.test.ts",
    "test:privacy-docx": "tsx tests/privacy/docxPlaceholders.test.ts",
    "test:study-write": "tsx tests/studyWrite/recordImport.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.6.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
